{
  "name": "carts-and-parts-operations",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs && prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "tsx scripts/check-database.ts",
    "db:migrate:development": "tsx scripts/migrate-development.ts",
    "admin:bootstrap:development": "tsx scripts/bootstrap-admin.ts",
    "test:access": "tsx --test tests/access-policy.test.ts",
    "test:attachments": "tsx --test tests/attachment-policy.test.ts && tsx scripts/test-attachments.ts",
    "test:trash": "tsx scripts/test-trash.ts",
    "cleanup:trash:development": "tsx scripts/cleanup-development-trash.ts",
    "test:orders": "tsx scripts/test-orders.ts",
    "test:copies": "tsx scripts/test-copy-orders.ts",
    "test:selection": "tsx scripts/test-order-selection.ts",
    "test:email": "tsx --test tests/order-email.test.ts && tsx scripts/test-email.ts",
    "test:price-books": "tsx scripts/test-price-books.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@clerk/nextjs": "^7.9.11",
    "@daypicker/react": "10.0.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-popover": "1.2.0",
    "dotenv": "18.0.6",
    "next": "16.3.8",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
