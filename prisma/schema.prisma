generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

// Login approval is separate from Clerk authentication and employee records.
model AppUser {
  id          String   @id @default(uuid()) @db.Uuid
  clerkUserId String   @unique
  email       String   @unique
  displayName String?
  role        UserRole @default(USER)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      SalesOrder[]
  events      OrderEvent[]
  assignments OrderAssignment[]
  notifications Notification[] @relation("Recipient")
  sentNotifications Notification[] @relation("Actor")
  emails OrderEmail[]
}

model SalesOrder {
  id         String @id @default(uuid()) @db.Uuid
  number     Int @unique @default(autoincrement())
  requestKey String @db.Uuid
  creatorId  String @db.Uuid
  creator    AppUser @relation(fields: [creatorId], references: [id])
  name       String?
  fields     Json @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  items      OrderItem[]
  events     OrderEvent[]
  assignments OrderAssignment[]
  notifications Notification[]
  emails OrderEmail[]
  @@unique([creatorId, requestKey])
}

model OrderItem {
  id          String @id @default(uuid()) @db.Uuid
  orderId     String @db.Uuid
  order       SalesOrder @relation(fields: [orderId], references: [id])
  position    Int
  description String @default("")
  quantity    Decimal? @db.Decimal(20, 6)
  unitPrice   Decimal? @db.Decimal(20, 2)
  @@unique([orderId, position])
}

model OrderEvent {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @db.Uuid
  order     SalesOrder @relation(fields: [orderId], references: [id])
  actorId   String @db.Uuid
  actor     AppUser @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())
  changes   Json
}

model OrderAssignment {
  orderId String @db.Uuid
  userId String @db.Uuid
  order SalesOrder @relation(fields: [orderId], references: [id])
  user AppUser @relation(fields: [userId], references: [id])
  @@id([orderId, userId])
  @@index([userId])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  recipientId String @db.Uuid
  actorId String @db.Uuid
  orderId String @db.Uuid
  recipient AppUser @relation("Recipient", fields: [recipientId], references: [id])
  actor AppUser @relation("Actor", fields: [actorId], references: [id])
  order SalesOrder @relation(fields: [orderId], references: [id])
  kind String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  readAt DateTime?
  @@index([recipientId, readAt, updatedAt])
  @@index([orderId, actorId, kind, updatedAt])
}

model OrderEmail {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  actorId String @db.Uuid
  requestKey String @db.Uuid
  order SalesOrder @relation(fields: [orderId], references: [id])
  actor AppUser @relation(fields: [actorId], references: [id])
  payload Json
  state String @default("PENDING")
  providerId String?
  createdAt DateTime @default(now())
  firstAttemptAt DateTime?
  lastAttemptAt DateTime?
  acceptedAt DateTime?
  @@unique([orderId, actorId, requestKey])
  @@index([orderId, createdAt])
}
