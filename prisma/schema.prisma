generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

// Login approval is separate from Clerk authentication and employee records.
model AppUser {
  id          String   @id @default(uuid()) @db.Uuid
  clerkUserId String   @unique
  email       String   @unique
  displayName String?
  role        UserRole @default(USER)
  active      Boolean  @default(true)
  loginDeletionRequestedAt DateTime?
  loginDeletedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      SalesOrder[]
  events      OrderEvent[]
  assignments OrderAssignment[]
  notifications Notification[] @relation("Recipient")
  sentNotifications Notification[] @relation("Actor")
  emails OrderEmail[]
  attachments OrderAttachment[]
  priceBookFiles PriceBookFile[]
  priceBookEvents PriceBookEvent[]
}

model UserAccessAudit {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  userId String @db.Uuid
  createdAt DateTime @default(now())
  changes Json
  @@index([createdAt])
  @@index([userId, createdAt])
}

model OrderChoice {
  id String @id @default(uuid()) @db.Uuid
  fieldKey String
  label String
  normalizedLabel String
  position Int
  active Boolean @default(true)
  version Int @default(1)
  @@unique([fieldKey, normalizedLabel])
  @@index([fieldKey, position])
}

model OrderChoiceAudit {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  choiceId String @db.Uuid
  createdAt DateTime @default(now())
  changes Json
  @@index([createdAt])
}

model EmployeeInvitation {
  id String @id @db.Uuid
  email String
  actorId String @db.Uuid
  state String @default("SENDING")
  providerId String? @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  acceptedUserId String? @db.Uuid
  @@index([email, state])
  @@index([createdAt])
}

model InvitationAudit {
  id String @id @default(uuid()) @db.Uuid
  invitationId String @db.Uuid
  actorId String
  action String
  createdAt DateTime @default(now())
  @@index([invitationId, createdAt])
}

model SalesOrder {
  id         String @id @default(uuid()) @db.Uuid
  number     Int @unique @default(autoincrement())
  requestKey String @db.Uuid
  creatorId  String @db.Uuid
  creator    AppUser @relation(fields: [creatorId], references: [id])
  name       String?
  fields     Json @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt DateTime?
  deletedById String? @db.Uuid
  purgeAfter DateTime?
  purgingAt DateTime?
  purgedAt DateTime?
  items      OrderItem[]
  events     OrderEvent[]
  assignments OrderAssignment[]
  notifications Notification[]
  emails OrderEmail[]
  attachments OrderAttachment[]
  @@unique([creatorId, requestKey])
  @@index([deletedAt, purgeAfter, purgedAt])
}

model OrderItem {
  id          String @id @default(uuid()) @db.Uuid
  orderId     String @db.Uuid
  order       SalesOrder @relation(fields: [orderId], references: [id])
  position    Int
  description String @default("")
  quantity    Decimal? @db.Decimal(20, 6)
  unitPrice   Decimal? @db.Decimal(20, 2)
  @@unique([orderId, position])
}

model OrderEvent {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @db.Uuid
  order     SalesOrder @relation(fields: [orderId], references: [id])
  actorId   String @db.Uuid
  actor     AppUser @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())
  changes   Json
}

model OrderAssignment {
  orderId String @db.Uuid
  userId String @db.Uuid
  order SalesOrder @relation(fields: [orderId], references: [id])
  user AppUser @relation(fields: [userId], references: [id])
  @@id([orderId, userId])
  @@index([userId])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  recipientId String @db.Uuid
  actorId String @db.Uuid
  orderId String @db.Uuid
  recipient AppUser @relation("Recipient", fields: [recipientId], references: [id])
  actor AppUser @relation("Actor", fields: [actorId], references: [id])
  order SalesOrder @relation(fields: [orderId], references: [id])
  kind String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  readAt DateTime?
  @@index([recipientId, readAt, updatedAt])
  @@index([orderId, actorId, kind, updatedAt])
}

model OrderEmail {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  actorId String @db.Uuid
  requestKey String @db.Uuid
  order SalesOrder @relation(fields: [orderId], references: [id])
  actor AppUser @relation(fields: [actorId], references: [id])
  payload Json
  state String @default("PENDING")
  providerId String?
  createdAt DateTime @default(now())
  firstAttemptAt DateTime?
  lastAttemptAt DateTime?
  acceptedAt DateTime?
  @@unique([orderId, actorId, requestKey])
  @@index([orderId, createdAt])
}

model OrderAttachment {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  uploaderId String @db.Uuid
  requestKey String @db.Uuid
  order SalesOrder @relation(fields: [orderId], references: [id])
  uploader AppUser @relation(fields: [uploaderId], references: [id])
  filename String
  contentType String
  size Int
  stagingKey String @unique
  storageKey String @unique
  state String @default("PENDING")
  createdAt DateTime @default(now())
  expiresAt DateTime
  uploadedAt DateTime?
  deletedAt DateTime?
  deletedById String? @db.Uuid
  stagingCleanedAt DateTime?
  objectCleanedAt DateTime?
  @@unique([orderId, uploaderId, requestKey])
  @@index([orderId, state, uploadedAt])
  @@index([state, expiresAt])
}

model PriceBook {
  key String @id
  currentFileId String? @db.Uuid
  edition String @default("")
  revision Int @default(0)
  updatedAt DateTime @updatedAt
  files PriceBookFile[]
  events PriceBookEvent[]
}

model PriceBookFile {
  id String @id @default(uuid()) @db.Uuid
  bookKey String
  book PriceBook @relation(fields: [bookKey], references: [key])
  uploaderId String @db.Uuid
  uploader AppUser @relation(fields: [uploaderId], references: [id])
  requestKey String @db.Uuid
  baseRevision Int
  edition String
  filename String
  size Int
  pages Int?
  stagingKey String @unique
  storageKey String @unique
  state String @default("PENDING")
  createdAt DateTime @default(now())
  expiresAt DateTime
  uploadedAt DateTime?
  stagingCleanedAt DateTime?
  objectCleanedAt DateTime?
  @@unique([uploaderId, requestKey])
  @@index([state, expiresAt])
}

model PriceBookEvent {
  id String @id @default(uuid()) @db.Uuid
  bookKey String
  book PriceBook @relation(fields: [bookKey], references: [key])
  actorId String @db.Uuid
  actor AppUser @relation(fields: [actorId], references: [id])
  createdAt DateTime @default(now())
  changes Json
  @@index([bookKey, createdAt])
}

model CalendarPerson {
  id String @id @default(uuid()) @db.Uuid
  name String
  userId String? @unique @db.Uuid
  color String @default("#1764A0")
  active Boolean @default(true)
  revision Int @default(0)
}

model CalendarCategory {
  id String @id @default(uuid()) @db.Uuid
  name String
  color String
  active Boolean @default(true)
  revision Int @default(0)
}

model CalendarEntry {
  id String @id @db.Uuid
  kind String
  creatorId String @db.Uuid
  payload Json
  exceptions Json @default("{}")
  revision Int @default(0)
  deletedAt DateTime?
  updatedAt DateTime @updatedAt
  @@index([kind, deletedAt])
}

model CalendarAudit {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  recordId String @db.Uuid
  recordType String
  createdAt DateTime @default(now())
  changes Json
  @@index([recordId, createdAt])
}
