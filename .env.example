# Copy to .env.local and supply development credentials. Never commit real keys.
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Server-only Resend key. Development sends only to kent@cartsandparts.com.
RESEND_API_KEY=
# Private development R2 bucket; never use NEXT_PUBLIC_ for credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=carts-parts-operations-development
# Optional server-only maintenance endpoint secret (32+ random characters).
# Hosted scheduling must be configured separately; localhost does not run cron.
CRON_SECRET=
