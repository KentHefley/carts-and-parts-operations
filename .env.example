# Copy to .env.local and supply development credentials. Never commit real keys.
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
# Pilot requires both values to be pilot, its separate enrolled services and project.
# NEXT_PUBLIC_APP_ENV is fixed at build time; rebuild when switching environments.
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Trusted app origin used in employee invitation links.
APP_URL=http://localhost:3000
# Comma-separated exact test recipient emails. Empty blocks all invitation sends.
INVITATION_ALLOWED_RECIPIENTS=
# Server-only Resend key. Development SO recipients use the exact allowlist in lib/email-config.ts.
RESEND_API_KEY=
# Pilot only: exact approved recipients; empty blocks every SO email.
SO_EMAIL_ALLOWED_RECIPIENTS=
# Private development R2 bucket; never use NEXT_PUBLIC_ for credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=carts-parts-operations-development
# Optional server-only maintenance endpoint secret (32+ random characters).
# Hosted scheduling must be configured separately; localhost does not run cron.
CRON_SECRET=
# Server-only Dropbox backup authorization; never use NEXT_PUBLIC_ names.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
